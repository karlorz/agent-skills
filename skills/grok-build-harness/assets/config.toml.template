# grok-build-harness config template — sanitized from cursor-box 2026-09-12.
# Operator SSOT: no GLM tables; grok-4.6 default; auto_compact 48%; gpt-5.6-sol
# (not gpt-5.6-auto); flash-non-reasoning public alias (not mimo-v2.5).
# CC Switch grokbuild apply of an old template can restore glm-5.x and drop
# skillwiki HTTP MCP. Sibling `config 2.toml` is a Finder/conflict copy — stale.
# Secrets are tokens substituted by scripts/generate-config.py (or install.sh):
#   __HUB_API_KEY__     hub.karldigi.dev gateway key
#   __NEW_API_KEY__     new.karldigi.dev gateway key
#   __CONTEXT7_API_KEY__  context7 MCP key
#   __ENABLED_PLUGINS__ comma-quoted plugin names (install.sh computes from flags)
# Empty api_key lines are dropped at generation time; env_key keeps working.
[cli]
installer = "internal"

[ui]
max_thoughts_width = 120
yolo = false
compact_mode = false
permission_mode = "__PERMISSION_MODE__"
voice_stt_language = "auto"
prompt_suggestions = true
fork_secondary_model = ""
remember_tool_approvals = true
cancel_subagents_on_turn_cancel = "always_stop"
follow_up_behavior = "steer"

[ui.notifications]
condition = "always"
events = [
    "turn_complete",
    "approval_required",
    "session_ready",
    "task_complete",
    "agent_error",
    "session_recap",
]

[compat.claude]
hooks = false
skills = false
permissions = false

[features]
remote_fetch = true
telemetry = false
web_fetch = true

[toolset.ask_user_question]
timeout_enabled = true
timeout_secs = 120
timeout_action = "recommended"

[models]
default = "grok-4.6"
default_reasoning_effort = "max"
session_summary = "flash-non-reasoning"

[model."grok-4.6"]
auto_compact_threshold_percent = 48

[model.kimi-k3]
model = "kimi-k3-256k"
base_url = "https://new.karldigi.dev/v1"
name = "kimi-k3-256k"
description = "kimi-k3-256k (chat_completions)"
api_key = "__NEW_API_KEY__"
env_key = "NEW_API_KEY"
api_backend = "chat_completions"
max_completion_tokens = 100000
context_window = 256000
supports_backend_search = false
supports_reasoning_effort = true
reasoning_effort = "max"
reasoning_efforts = [
    "max",
    "high",
]
stream_tool_calls = false

[model.kimi-k3.tools]
deny = [
    "web_search",
    "web_fetch",
]

[model.flash-max]
model = "flash-max"
base_url = "https://new.karldigi.dev/v1"
name = "flash-max"
description = "flash-max gemini-3.7-flash deepseek-flash (chat_completions)"
api_key = "__NEW_API_KEY__"
env_key = "NEW_API_KEY"
api_backend = "chat_completions"
