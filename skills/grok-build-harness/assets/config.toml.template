[marketplace]
official_marketplace_auto_installed = true
default_skills_installs_purged = true

[[marketplace.sources]]
name = "xAI Official"
git = "https://github.com/xai-org/plugin-marketplace.git"

[[marketplace.sources]]
name = "karlorz-agent-skills"
git = "https://github.com/karlorz/agent-skills.git"

[[marketplace.sources]]
name = "karlorz-llm-wiki"
git = "https://github.com/karlorz/llm-wiki.git"

[plugins]
enabled = ["__ENABLED_PLUGINS__"]
paths = []

[permission]
deny = []

[subagents]
enabled = true

[subagents.models]
general-purpose = "sonnet"
explore = "sonnet"
browser-use = "sonnet"
scout = "sonnet"

[subagents.toggle]
grok-build-byok = false
grok-build = true

[agent]
name = "grok-build-byok"

[skills]
paths = []
ignore = [
    "~/.agents/skills/frontend-design",
    "~/.claude/plugins/marketplaces/claude-plugins-official/plugins/frontend-design",
]
disabled = ["frontend-design"]
server_skill_dirs = []
bundled_skill_dirs = []

[workflows.builtins]
deep-research = false

[mcp_servers.context7]
command = "npx"
args = [
    "-y",
    "@upstash/context7-mcp",
    "--api-key",
    "__CONTEXT7_API_KEY__",
]
