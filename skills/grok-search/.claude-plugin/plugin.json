{
  "name": "grok-search",
  "version": "0.1.13",
  "description": "Thin marketplace plugin for GrokSearch: live web search, structured intent planning, source extraction, URL fetching, and site mapping via HTTP MCP.",
  "author": {
    "name": "karlorz"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "grok",
    "search",
    "web-search",
    "research",
    "http"
  ],
  "skills": "./skills/",
  "hooks": "./claude-hooks/hooks.json",
  "userConfig": {
    "GROK_SEARCH_MCP_TOKEN": {
      "type": "string",
      "title": "Grok Search gateway-keys bearer",
      "description": "Gateway key created at https://search.karldigi.dev/admin/gateway-keys.",
      "sensitive": true,
      "required": true
    }
  }
}
