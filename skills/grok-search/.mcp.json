{
  "mcpServers": {
    "grok-search": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-grok-search.sh"
      ],
      "env": {
        "GUDA_API_KEY": "${GUDA_API_KEY}",
        "GUDA_BASE_URL": "${GUDA_BASE_URL}"
      }
    },
    "grok-search-http": {
      "type": "http",
      "url": "http://100.76.134.104:8800/mcp",
      "headers": {
        "Authorization": "Bearer ${GROK_SEARCH_MCP_TOKEN}"
      }
    }
  }
}
